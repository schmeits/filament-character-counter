{
    "name": "schmeits/filament-character-counter",
    "description": "A character counter for the TextInput, Textarea and RichEditor fields of Filament 4 and 5",
    "keywords": [
        "schmeits",
        "laravel",
        "filament",
        "filament-plugin",
        "character-counter",
        "forms"
    ],
    "homepage": "https://github.com/schmeits/filament-character-counter",
    "support": {
        "issues": "https://github.com/schmeits/filament-character-counter/issues",
        "source": "https://github.com/schmeits/filament-character-counter"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Tally Schmeits",
            "email": "tally@schmeits.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0|^5.0",
        "filament/support": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.1|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Schmeits\\FilamentCharacterCounter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schmeits\\FilamentCharacterCounter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schmeits\\FilamentCharacterCounter\\FilamentCharacterCounterServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
